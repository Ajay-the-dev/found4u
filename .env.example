# ── Firebase (Project settings → General → Your apps → Web app config) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Region your Cloud Functions are deployed to (must match functions/index.js)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Set to "true" to use the local Firebase Emulator Suite (npm run emulators)
VITE_USE_EMULATORS=false

# ── Cloudinary (Console → Settings → Upload → Upload presets) ──
# Leave VITE_CLOUDINARY_CLOUD_NAME empty to fall back to Firebase Storage.
VITE_CLOUDINARY_CLOUD_NAME=
# Unsigned mode: name of an *unsigned* upload preset
VITE_CLOUDINARY_UPLOAD_PRESET=foundit_unsigned
# Signed mode: "true" asks the cloudinarySignature Cloud Function to sign each upload
# (requires CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET on the functions side)
VITE_CLOUDINARY_SIGNED=false

# ── Maps ──
# Any Leaflet-compatible XYZ tile URL. Defaults to OpenStreetMap.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Default map centre "lat,lng" when no organization centre / GPS is available
VITE_MAP_DEFAULT_CENTER=40.7128,-74.0060
