{
  "name": "foundit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FoundIt — organization-aware Lost & Found with QR asset tags, geofenced alerts and real-time chat",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "deploy": "vite build && firebase deploy --only hosting:lofu,functions:lofu",
    "test:rules": "firebase emulators:exec --only firestore --project demo-foundit \"node --test tests/rules.test.js\"",
    "test:functions": "npm --prefix functions test",
    "test:e2e": "firebase emulators:exec --only firestore,functions --project demo-foundit \"node --test tests/functions.e2e.test.js\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "firebase": "^13.1.0",
    "leaflet": "^1.9.4",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "geofire-common": "^6.0.0",
    "vite": "^8.3.5"
  }
}
