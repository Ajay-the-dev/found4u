rules_version = '2';

// Firebase Storage is the fallback image store when Cloudinary is not configured.
// SHARED BUCKET: deploying this file replaces the bucket's rules — merge the `lofu/` block into yours.
service firebase.storage {
  match /b/{bucket}/o {
    match /lofu/uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
